# Copy this file to app/.env and replace the placeholders before running docker compose.
# app/.env is ignored by git; never commit real credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-value
MYSQL_PASSWORD=replace-with-a-different-long-random-value
YUJING_ADMIN_USERNAME=admin
YUJING_ADMIN_PASSWORD=replace-with-a-strong-admin-password
COOKIE_SECURE=false
YUJING_CORS_ORIGINS=http://localhost:5173
